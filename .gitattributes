# Force shell scripts to use LF line endings on all platforms
*.sh text eol=lf

# Force other text files to use LF
*.env text eol=lf
*.conf text eol=lf
*.ora text eol=lf
*.sql text eol=lf

# YAML and config files
*.yml text eol=lf
*.yaml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Vagrantfile
Vagrantfile text eol=lf

# Binary files
*.zip binary
*.jar binary
*.vdi binary
*.vmdk binary
*.vbox binary

*.bat text eol=crlf
*.cmd text eol=crlf